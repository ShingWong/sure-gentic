{
  "name": "@shing.wong/sure-gentic",
  "version": "0.1.0",
  "description": "Provider-agnostic AI agent framework with skill-based architecture",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && tsc -p tsconfig.nodenext.json && node scripts/smoke/node-import.mjs && node scripts/smoke/tool-name.mjs && node scripts/smoke/no-process.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.24.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^20.11.0",
    "openai": "^6.48.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
